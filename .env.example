# ==============================================================================
# SEREIN BEAUTY - PAYMENT & CHECKOUT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Obtain test API keys from Stripe Dashboard (https://dashboard.stripe.com/test/apikeys)
# 2. Never hard-code or commit real secret keys into source control.
# 3. Keep in test mode (starts with sk_test_) until ready for live production.

# Stripe Secret API Key (Server-side only)
STRIPE_SECRET_KEY=sk_test_placeholder_your_secret_key_here

# Stripe Publishable Key (Client-side, optional for Elements/Checkout)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_your_publishable_key_here

# Stripe Webhook Signing Secret (Obtain via `stripe listen --forward-to localhost:4173/api/webhook` or Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_placeholder_your_webhook_secret_here

# Store Pricing & Currency Configuration (Trusted Server-Side Defaults)
# Strictly NOT the $16.37 supplier cost!
STORE_RETAIL_PRICE=48.00
STORE_CURRENCY=usd

# Standalone Server Port
PORT=3001

# Transactional Email Provider (Optional - leave blank if not configured yet)
# To enable automatic order confirmation emails, configure Resend or SendGrid below:
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# SENDER_EMAIL=orders@sereinbeauty.com
