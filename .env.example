# ==============================================================================
# SEREIN BEAUTY - VERCEL & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions for Vercel Deployment:
# Add these variables in Vercel Dashboard > Project Settings > Environment Variables:

# 1. Shopify Store Domain
SHOPIFY_STORE_DOMAIN=f0jzb7-r0.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=f0jzb7-r0.myshopify.com

# 2. Shopify Product Variant ID for The Serein Heatless Curl Set
SHOPIFY_VARIANT_ID=51592955855122
VITE_SHOPIFY_VARIANT_ID=51592955855122

# 3. Shopify Storefront API Access Token (Public)
# How to get this:
# Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
# Click "Create an app" -> Configure Storefront API scopes (unauthenticated_read_product_listings, unauthenticated_write_checkouts, etc.)
# Click "Install app" -> Copy "Storefront API access token"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token_here
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token_here

# 4. Shopify Storefront API Version
SHOPIFY_API_VERSION=2024-07
VITE_SHOPIFY_API_VERSION=2024-07

# Store Defaults
STORE_RETAIL_PRICE=48.00
STORE_CURRENCY=usd
PORT=3001
