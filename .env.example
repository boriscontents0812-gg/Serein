# ==============================================================================
# SEREIN BEAUTY - PAYMENT & CHECKOUT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Enter your Shopify store domain (e.g. your-store.myshopify.com or brand.com)
# 2. Enter your Shopify product variant ID (found in Shopify Admin > Products)
# 3. Direct checkout works instantly via Shopify Cart Permalinks without API keys!

# Shopify Configuration (Client & Server)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

SHOPIFY_VARIANT_ID=44812345678901
VITE_SHOPIFY_VARIANT_ID=44812345678901

# Store Pricing & Currency Defaults
STORE_RETAIL_PRICE=48.00
STORE_CURRENCY=usd

# Standalone Server Port
PORT=3001

# Optional: Stripe (Detached / Legacy backup)
# STRIPE_SECRET_KEY=sk_test_placeholder_your_secret_key_here
# STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_your_publishable_key_here
# STRIPE_WEBHOOK_SECRET=whsec_placeholder_your_webhook_secret_here

# Transactional Email Provider (Optional)
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# SENDER_EMAIL=orders@sereinbeauty.com
